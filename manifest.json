{
  "manifest_version": 3,
  "name": "Canvas Pro-Tools",
  "version": "4.1.0",
  "description": "Gradebook review tracking, SpeedGrader tweaks, quiz navigation, and rubric enhancements for Canvas LMS instructors.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instructure.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instructure.com/courses/*/grades/*"],
      "js": ["what-if-grades.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/accounts/*"],
      "js": ["cpt-instance.js", "admin-course-links.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instructure.com/accounts/*/users/*",
        "https://*.instructure.com/users/*"
      ],
      "js": ["cpt-instance.js", "user-enrollments.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook*"],
      "js": ["cpt-instance.js", "gradebook-tracker.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook/speed_grader*"],
      "js": ["cpt-instance.js", "speedgrader.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook/speed_grader*"],
      "js": ["graded-at.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook/speed_grader*"],
      "js": ["sg-avatar-zoom.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.instructure.com/courses/*/gradebook/speed_grader*"],
      "js": ["cpt-instance.js", "checkpoint-mapper.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/assignments",
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.instructure.com/courses/*/discussion_topics/*",
        "https://*.instructure.com/courses/*/rubrics",
        "https://*.instructure.com/courses/*/rubrics/*"
      ],
      "exclude_matches": [
        "https://*.instructure.com/courses/*/quizzes/*/history",
        "https://*.instructure.com/courses/*/quizzes/*/history?*"
      ],
      "js": ["feature-flags.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/quizzes/*/history",
        "https://*.instructure.com/courses/*/quizzes/*/history?*"
      ],
      "js": ["feature-flags.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/quizzes/*/history",
        "https://*.instructure.com/courses/*/quizzes/*/history?*"
      ],
      "js": ["quiz-nav.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.instructure.com/courses/*/discussion_topics/*"
      ],
      "js": ["rubric-sorter.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/rubrics",
        "https://*.instructure.com/courses/*/rubrics/*",
        "https://*.instructure.com/courses/*/assignments/*",
        "https://*.instructure.com/courses/*/quizzes/*",
        "https://*.instructure.com/courses/*/discussion_topics/*"
      ],
      "js": ["rubric-exporter.js", "cpt-panel.js", "rubric-info.js", "rubric-assoc-editor.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/assignments"
      ],
      "js": ["cpt-panel.js", "assignment-details.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.instructure.com/courses/*/rubrics",
        "https://*.instructure.com/courses/*/rubrics/*",
        "https://*.instructure.com/courses/*/discussion_topics/*"
      ],
      "js": ["cpt-instance.js", "rubric-checkpoint-mapper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Canvas Pro-Tools"
  },
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
